# Copia este archivo a .env (NO subir .env al repositorio).
# Node-RED lee estas variables si las defines ANTES de iniciarlo (ver README).
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

INFLUX_URL=http://localhost:8086
INFLUX_ORG=dcandino
INFLUX_BUCKET=sala_servidores
INFLUX_TOKEN=REEMPLAZAR_CON_TU_TOKEN

# Umbrales didacticos configurables (no son limites normativos)
UMBRAL_ADVERTENCIA=28
UMBRAL_CRITICO=30
LUZ_BAJA_PCT=20
LUZ_ALTA_PCT=70
